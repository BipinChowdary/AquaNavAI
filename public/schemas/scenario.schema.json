{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aquanavai.example/schemas/scenario.schema.json",
  "title": "AquaNavAI static scenario manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "version",
    "generatedAt",
    "dataMode",
    "immutable",
    "bbox",
    "crs",
    "forecastCycles",
    "departureTimes",
    "referenceVehicleId",
    "disclaimer",
    "citations",
    "files",
    "checksums"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "dataMode": { "enum": ["offline-proxy", "pinned-noaa"] },
    "immutable": { "const": true },
    "bbox": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number" },
        { "type": "number" }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "crs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysis", "interchange"],
      "properties": {
        "analysis": { "type": "string" },
        "interchange": { "type": "string" }
      }
    },
    "forecastCycles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "date-time" }
    },
    "departureTimes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "date-time" }
    },
    "referenceVehicleId": { "type": "string" },
    "disclaimer": { "type": "string", "minLength": 20 },
    "citations": { "type": "array", "items": { "type": "string" } },
    "files": {
      "type": "object",
      "required": [
        "bathymetry",
        "coastline",
        "currents",
        "metrics",
        "provenance",
        "routes",
        "stations"
      ],
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      }
    },
    "checksums": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "dataMode": { "const": "pinned-noaa" } },
        "required": ["dataMode"]
      },
      "then": { "properties": { "files": { "required": ["grid"] } } }
    }
  ]
}
